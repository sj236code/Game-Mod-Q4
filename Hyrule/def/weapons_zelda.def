// Hyrule mod – Zelda-themed weapon defs
// These inherit from the stock Quake 4 weapons but change names so they can be
// treated as Zelda weapons in player defs and maps.

// Master Sword – baseline melee / sidearm
entityDef weapon_master_sword {
	"inherit"           "weapon_gauntlet"

	"inv_name"          "Master Sword"
	"name"              "Master Sword"

	// High damage to match the master swords power
	"damage"			"80"
	// Fast attach rate -> sword swings quickly
	"fireRate" 			"0.3"
}

// Soldier's Bow – mid‑tier bow (shotgun stand‑in)
entityDef weapon_soldiers_bow {
	"inherit"           "weapon_shotgun"

	"inv_name"          "Soldier's Bow"
	"name"              "Soldier's Bow"

	// Fires 1 arrow, not a spread of pellets
	"numProjectiles"    "1"
	// Tight spread to mimic arrows
	"spread"			"0"
	// Slightly higher damage than default machinegun per arrow
	"damage"			"18"
	// Moderate fire rate
	"fireRate"			"0.12"

}

// Traveler's Bow – basic rapid‑fire bow (machinegun stand‑in)
entityDef weapon_travelers_bow {
    "inherit"       "weapon_machinegun"

    "inv_name"      "Traveler's Bow"
    "name"          "Traveler's Bow"

    // slower than stock machinegun
    "fireRate"      "0.9"

    // if zoomed, also keep it slow
    "altFireRate"   "0.9"

    // normal firing spread
    "spread"        "0"

    // zoom firing spread
    "spreadZoom"    "0"
}

// Guardian Bow – high‑tech bow (hyperblaster stand‑in)
entityDef weapon_guardian_bow {
	"inherit"           "weapon_hyperblaster"

	"inv_name"          "Guardian Bow"
	"name"              "Guardian Bow"

	// Fast energy pulse fire
	"fireRate"          "0.12"
	// Moderate damage per shot
	"damage"            "20"
	// No spread -> precise guardian tech
	"spread"            "0"
}

// Remote Bomb Rune – explosive rune (rocket launcher stand‑in)
entityDef weapon_remote_bomb {
	"inherit"           "weapon_rocketlauncher"

	"inv_name"          "Remote Bomb"
	"name"              "Remote Bomb"

	// Very slow fire rate -> placing a bomb takes time
	"fireRate"          "2.0"
	// High explosive damage
	"damage"            "120"

}

// Fire Rod – fire‑based magic / weapon (napalm gun stand‑in)
entityDef weapon_fire_rod {
	"inherit"           "weapon_napalmgun"

	"inv_name"          "Fire Rod"
	"name"              "Fire Rod"

	// Moderate fire rate -> casting magic
	"fireRate"          "0.8"
	// Good fire damage
	"damage"            "40"
}

// Thunderblade – electric melee (lightning gun stand‑in)
entityDef weapon_thunderblade {
	"inherit"           "weapon_lightninggun"

	"inv_name"          "Thunderblade"
	"name"              "Thunderblade"

	// High electric damage per tick
	"damage"            "18"
	// Slightly shorter beam range than default
	"range"             "500"

}

// Ancient Bow – very strong, precise bow (railgun stand‑in)
entityDef weapon_ancient_bow {
	"inherit"           "weapon_railgun"

	"inv_name"          "Ancient Bow"
	"name"              "Ancient Bow"
	
	// Very slow fire rate -> charging an ancient arrow
	"fireRate"          "2.5"
	// Massive damage -> ancient tech
	"damage"            "200"
	// No spread -> pinpoint accuracy
	"spread"            "0"
}

// Lizal Boomerang – arcing thrown weapon (grenade launcher stand‑in)
entityDef weapon_lizal_boomerang {
	"inherit"           "weapon_grenadelauncher"

	"inv_name"          "Lizal Boomerang"
	"name"              "Lizal Boomerang"

	// Moderate fire rate -> throwing a boomerang
	"fireRate"          "1.0"
	// Moderate damage
	"damage"            "60"
}

// Boko Club – simple melee (gauntlet stand‑in)
entityDef weapon_boko_club {
	"inherit"           "weapon_gauntlet"

	"inv_name"          "Boko Club"
	"name"              "Boko Club"

	// High damage but slower than Master Sword -> crude heavy club
	"damage"            "60"
	"fireRate"          "0.7"
}

entityDef player_marine
{
    "inherit"               "player_marine"
    "def_weapon1"           "weapon_travelers_bow"
    "def_weapon2"           "weapon_soldiers_bow"
    "def_weapon3"           "weapon_guardian_bow"
    "def_weapon4"           "weapon_lizal_boomerang"
    "def_weapon6"           "weapon_remote_bomb"
    "def_weapon7"           "weapon_ancient_bow"
    "def_weapon8"           "weapon_thunderblade"
    "weapon"                "weapon_master_sword"
}