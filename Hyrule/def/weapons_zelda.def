// Hyrule mod – Zelda-themed weapon defs
// These inherit from the stock Quake 4 weapons but change names so they can be
// treated as Zelda weapons in player defs and maps.

// Master Sword – baseline melee / sidearm
entityDef weapon_master_sword {
	"inherit"           "weapon_gauntlet"

	"inv_name"          "Master Sword"
	"name"              "Master Sword"
}

// Soldier's Bow – mid‑tier bow (shotgun stand‑in)
entityDef weapon_soldiers_bow {
	"inherit"           "weapon_shotgun"

	"inv_name"          "Soldier's Bow"
	"name"              "Soldier's Bow"
	// "model_view"     "models/weapons/hyrule/soldiers_bow_view.lwo"
	// "model_world"    "models/weapons/hyrule/soldiers_bow_world.lwo"
}

// Traveler's Bow – basic rapid‑fire bow (machinegun stand‑in)
entityDef weapon_travelers_bow {
