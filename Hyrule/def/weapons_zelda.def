	"inv_name"          "Traveler's Bow"
	"name"              "Traveler's Bow"
	// "model_view"     "models/weapons/hyrule/travelers_bow_view.lwo"
	// "model_world"    "models/weapons/hyrule/travelers_bow_world.lwo"
}

