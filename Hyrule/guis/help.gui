windowDef Desktop
{
	rect		0, 0, 640, 480
	visible		1
	nocursor	0
	menugui		0

	// Dark overlay background
	windowDef bg
	{
		rect		0, 0, 640, 480
		backcolor	0, 0, 0, 0.90
		visible		1
	}

	// Decorative top border line
	windowDef border_top
	{
		rect		30, 44, 580, 2
		backcolor	0.82, 0.70, 0.10, 0.8
		visible		1
	}

	// Decorative bottom border line
	windowDef border_bottom
	{
		rect		30, 434, 580, 2
		backcolor	0.82, 0.70, 0.10, 0.8
		visible		1
	}

	// Title
	windowDef title
	{
		rect		0, 10, 640, 32
		visible		1
		forecolor	0.98, 0.88, 0.20, 1
		textscale	0.55
		font		"fonts/marine"
		textalign	1
		textstyle	1
		text		"HYRULE MOD  –  HELP"
	}

	// Subtitle
	windowDef subtitle
	{
		rect		0, 38, 640, 14
		visible		1
		forecolor	0.70, 0.85, 1.0, 0.75
		textscale	0.22
		font		"fonts/marine"
		textalign	1
		text		"A Zelda: Breath of the Wild reskin for Quake 4"
	}

	//----------------------------------------------------
	// SECTION 1 – Zelda Weapons
	//----------------------------------------------------
	windowDef sec1_icon
	{
		rect		40, 58, 8, 8
		backcolor	0.98, 0.88, 0.20, 1
		visible		1
	}
	windowDef sec1_heading
	{
		rect		54, 52, 560, 18
		visible		1
		forecolor	0.98, 0.88, 0.20, 1
		textscale	0.30
		font		"fonts/marine"
		textstyle	1
		text		"ZELDA WEAPONS"
	}
	windowDef sec1_body
	{
		rect		54, 68, 550, 40
		visible		1
		forecolor	0.86, 0.92, 0.76, 0.9
		textscale	0.20
		font		"fonts/marine"
		text		"Master Sword (fast melee, 80 dmg)  |  Traveler's Bow (single arrow, slow)  |  Soldier's Bow (heavy arrow, 55 dmg)  |  Guardian Bow (rapid ancient pulses, 20 dmg)  |  Remote Bomb (2s fuse, 120 dmg)  |  Fire Rod (fire bursts, 40 dmg)  |  Thunderblade (electric beam, 18/tick)  |  Ancient Bow (charge shot, 200 dmg)  |  Lizal Boomerang (arcing, 60 dmg)  |  Boko Club (slow melee, 60 dmg)"
	}

	windowDef div1
	{
		rect		54, 108, 556, 1
		backcolor	0.82, 0.70, 0.10, 0.35
		visible		1
	}

	//----------------------------------------------------
	// SECTION 2 – Zelda Beasts & Weaknesses
	//----------------------------------------------------
	windowDef sec2_icon
	{
		rect		40, 118, 8, 8
		backcolor	0.98, 0.88, 0.20, 1
		visible		1
	}
	windowDef sec2_heading
	{
		rect		54, 112, 560, 18
		visible		1
		forecolor	0.98, 0.88, 0.20, 1
		textscale	0.30
		font		"fonts/marine"
		textstyle	1
		text		"DIVINE BEASTS  &  CALAMITY GANON"
	}
	windowDef sec2_body
	{
		rect		54, 128, 550, 52
		visible		1
		forecolor	0.86, 0.92, 0.76, 0.9
		textscale	0.20
		font		"fonts/marine"
		text		"Vah Naboris (350 HP)  weakness: Ancient Bow  |  Vah Medoh (300 HP)  weakness: Traveler's Bow\nVah Rudania (600 HP)  weakness: Remote Bomb  |  Vah Ruta (700 HP)  weakness: Thunderblade\nCalamity Ganon (2000 HP)  weakness: Master Sword + Ancient Bow  (final boss – never retreats)\nHit each beast with its weakness weapon for 2x bonus damage!"
	}

	windowDef div2
	{
		rect		54, 182, 556, 1
		backcolor	0.82, 0.70, 0.10, 0.35
		visible		1
	}

	//----------------------------------------------------
	// SECTION 3 – Findable Items
	//----------------------------------------------------
	windowDef sec3_icon
	{
		rect		40, 192, 8, 8
		backcolor	0.98, 0.88, 0.20, 1
		visible		1
	}
	windowDef sec3_heading
	{
		rect		54, 186, 560, 18
		visible		1
		forecolor	0.98, 0.88, 0.20, 1
		textscale	0.30
		font		"fonts/marine"
		textstyle	1
		text		"FINDABLE ITEMS"
	}
	windowDef sec3_body
	{
		rect		54, 202, 550, 40
		visible		1
		forecolor	0.86, 0.92, 0.76, 0.9
		textscale	0.20
		font		"fonts/marine"
		text		"Five items are hidden throughout the map – find them all!\nGreen Rupee (+1)  |  Blue Rupee (+5)  |  Red Rupee (+20)  |  Korok Seed (+15% jump height)  |  Stamina Vessel (+10% run speed)\nRupees go straight to your wallet. Korok Seeds and Stamina Vessels stack permanently – collect as many as you can."
	}

	windowDef div3
	{
		rect		54, 244, 556, 1
		backcolor	0.82, 0.70, 0.10, 0.35
		visible		1
	}

	//----------------------------------------------------
	// SECTION 4 – Rupee Store
	//----------------------------------------------------
	windowDef sec4_icon
	{
		rect		40, 254, 8, 8
		backcolor	0.98, 0.88, 0.20, 1
		visible		1
	}
	windowDef sec4_heading
	{
		rect		54, 248, 560, 18
		visible		1
		forecolor	0.98, 0.88, 0.20, 1
		textscale	0.30
		font		"fonts/marine"
		textstyle	1
		text		"RUPEE STORE"
	}
	windowDef sec4_body
	{
		rect		54, 264, 550, 40
		visible		1
		forecolor	0.86, 0.92, 0.76, 0.9
		textscale	0.20
		font		"fonts/marine"
		text		"Press [ B ] to open the store. Your rupee count is always shown in the top-right of the HUD.\nHealth Upgrade  +25 max HP  –  10 rupees  |  Speed Upgrade  +10% run speed  –  15 rupees\nAmmo Refill  refills all ammo  –  5 rupees  |  All upgrades stack – buy as many times as you can afford."
	}

	windowDef div4
	{
		rect		54, 306, 556, 1
		backcolor	0.82, 0.70, 0.10, 0.35
		visible		1
	}

	//----------------------------------------------------
	// SECTION 5 – Tips
	//----------------------------------------------------
	windowDef sec5_icon
	{
		rect		40, 316, 8, 8
		backcolor	0.98, 0.88, 0.20, 1
		visible		1
	}
	windowDef sec5_heading
	{
		rect		54, 310, 560, 18
		visible		1
		forecolor	0.98, 0.88, 0.20, 1
		textscale	0.30
		font		"fonts/marine"
		textstyle	1
		text		"TIPS"
	}
	windowDef sec5_body
	{
		rect		54, 326, 550, 40
		visible		1
		forecolor	0.86, 0.92, 0.76, 0.9
		textscale	0.20
		font		"fonts/marine"
		text		"Exploit beast weaknesses – 2x damage makes tough fights much faster. Stack Korok Seeds and Stamina Vessels before fighting late enemies.\nSave rupees for Health Upgrades before taking on Calamity Ganon. Fighting Ganon without the Master Sword or Ancient Bow is possible but will take significantly longer.\nYou can buy Speed Upgrades multiple times – each one stacks for faster and faster movement."
	}

	windowDef div5
	{
		rect		54, 368, 556, 1
		backcolor	0.82, 0.70, 0.10, 0.35
		visible		1
	}

	//----------------------------------------------------
	// Controls reminder
	//----------------------------------------------------
	windowDef controls_body
	{
		rect		54, 372, 550, 22
		visible		1
		forecolor	0.70, 0.85, 1.0, 0.85
		textscale	0.20
		font		"fonts/marine"
		text		"Open Store: [ B ]     Close Store: [ B / ESC ]     Open Help: [ H ]     Close Help: [ H / ESC ]     Cycle Weapons: [ Mouse Wheel ]"
	}

	//----------------------------------------------------
	// Close button
	//----------------------------------------------------
	windowDef close_btn
	{
		rect		245, 408, 150, 26
		visible		1
		backcolor	0.10, 0.10, 0.10, 0.85
		forecolor	0.98, 0.88, 0.20, 1
		textscale	0.28
		font		"fonts/marine"
		textalign	1
		textstyle	1
		text		"[ CLOSE HELP ]"

		onMouseEnter {
			set "backcolor" "0.20, 0.16, 0.02, 0.95" ;
			set "forecolor" "1, 1, 0.5, 1" ;
		}
		onMouseExit {
			set "backcolor" "0.10, 0.10, 0.10, 0.85" ;
			set "forecolor" "0.98, 0.88, 0.20, 1" ;
		}
		onAction {
			set "cmd" "close" ;
		}
	}
}
